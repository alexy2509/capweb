---
const navLinks = [
  { href: '/',          label: 'Accueil'  },
  { href: '/services',  label: 'Services' },
  { href: '/a-propos',  label: 'À propos' },
];

const currentPath = Astro.url.pathname;
---

<header class="header" id="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Accueil CapWeb">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img
          src="/logo.png"
          alt="CapWeb · agence de création de sites internet à Quimper, Finistère, Bretagne"
          width="220"
          height="38"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </a>

    <nav class="header__nav" id="nav" aria-label="Navigation principale">
      <ul class="header__nav-list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class={`header__nav-link ${currentPath === link.href ? 'is-active' : ''}`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact" class="btn btn-primary header__cta">Devis gratuit</a>
    </nav>

    <button class="header__burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background-color 0.4s ease, box-shadow 0.4s ease;
  }

  .header.scrolled,
  .header.menu-open {
    background-color: rgba(14, 6, 4, 0.96);
    box-shadow: 0 2px 24px rgba(255, 78, 80, 0.15);
  }

  /* Backdrop-filter coûteux : seulement sur desktop */
  @media (min-width: 769px) {
    .header.scrolled,
    .header.menu-open {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5rem;
    position: relative;
    z-index: 2;
  }

  .header__logo img {
    height: 36px;
    width: auto;
    transition: opacity var(--transition);
  }

  .header__logo:hover img { opacity: 0.85; }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .header__nav-list {
    display: flex;
    list-style: none;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 248, 242, 0.78);
    transition: color var(--transition);
    position: relative;
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gradient-primary);
    border-radius: 2px;
    transition: width var(--transition);
  }

  .header__nav-link:hover,
  .header__nav-link.is-active {
    color: var(--color-text-light);
  }

  .header__nav-link:hover::after,
  .header__nav-link.is-active::after {
    width: 100%;
  }

  .header__cta {
    padding: 0.625rem 1.5rem;
    font-size: 0.75rem;
  }

  /* Burger */
  .header__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 3;
  }

  .header__burger span {
    display: block;
    width: 24px;
    height: 1.5px;
    background-color: var(--color-text-light);
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .header__burger.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .header__burger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .header__burger.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  @media (max-width: 1024px) {
    .header__burger { display: flex; }

    /* Overlay plein écran sous l'en-tête */
    .header__nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100dvh;
      padding: 6rem 1.5rem 2.5rem;
      background-color: rgba(14, 6, 4, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      gap: 2rem;
      overflow-y: auto;
      overscroll-behavior: contain;

      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
      z-index: 1;
    }

    .header__nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s;
    }

    .header__nav-list {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      width: 100%;
    }

    .header__nav-list li {
      width: 100%;
      text-align: center;
    }

    .header__nav-link {
      display: inline-block;
      font-size: 1.15rem;
      letter-spacing: 0.18em;
      padding: 0.5rem 1rem;
    }

    .header__cta {
      margin-top: 1rem;
      padding: 0.95rem 2.75rem;
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const header = document.getElementById('header')!;
  const burger = document.getElementById('burger')!;
  const nav    = document.getElementById('nav')!;

  /* Scroll → fond sombre */
  const onScroll = () => {
    header.classList.toggle('scrolled', window.scrollY > 40);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setMenu = (open: boolean) => {
    burger.classList.toggle('is-open', open);
    nav.classList.toggle('is-open', open);
    header.classList.toggle('menu-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    document.body.style.overflow = open ? 'hidden' : '';
  };

  /* Burger */
  burger.addEventListener('click', () => {
    setMenu(!burger.classList.contains('is-open'));
  });

  /* Fermer en cliquant sur un lien */
  nav.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });

  /* Fermer avec Échap */
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger.classList.contains('is-open')) setMenu(false);
  });

  /* Fermer si on repasse en desktop */
  const mq = window.matchMedia('(min-width: 1025px)');
  mq.addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>
