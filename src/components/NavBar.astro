---
const navLinks = [
  { href: '/',          label: 'Accueil'  },
  { href: '/services',  label: 'Services' },
  { href: '/a-propos',  label: 'À propos' },
];

const currentPath = Astro.url.pathname;
---

<header class="header" id="header">
  <div class="header__bar">
    <a href="/" class="header__logo" aria-label="Accueil CapWeb">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img
          src="/logo.png"
          alt="CapWeb · agence de création de sites internet à Quimper, Finistère, Bretagne"
          width="220"
          height="38"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </a>

    <nav class="header__nav" id="nav" aria-label="Navigation principale">
      <ul class="header__nav-list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class={`header__nav-link ${currentPath === link.href ? 'is-active' : ''}`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact" class="btn btn-primary header__cta">Devis gratuit</a>
    </nav>

    <button class="header__burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  /* ====== Conteneur flottant fixe ====== */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0.85rem var(--spacing-md);
    transition: padding 0.35s ease;
  }

  /* Resserre légèrement la barre quand on scrolle (effet "snap" iOS) */
  .header.scrolled {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  /* ====== Le "pill" en verre dépoli ====== */
  .header__bar {
    position: relative;
    isolation: isolate;            /* contexte d'empilement propre, sans bloc englobant */
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.75rem;
    padding: 0 0.6rem 0 1.4rem;
    border-radius: 999px;
  }

  /* Le flou est porté par ::before : backdrop-filter sur .header__bar
     créerait un bloc englobant qui casserait l'overlay mobile (position: fixed). */
  .header__bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: rgba(18, 9, 6, 0.18);
    backdrop-filter: blur(16px) saturate(170%);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.10);
    transition: background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
    pointer-events: none;
  }

  /* Plus opaque au scroll / menu ouvert → texte clair lisible sur fond clair */
  .header.scrolled .header__bar::before,
  .header.menu-open .header__bar::before {
    background: rgba(14, 7, 4, 0.52);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow:
      0 14px 38px rgba(0, 0, 0, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .header__logo {
    display: flex;
    align-items: center;
  }

  .header__logo img {
    height: 30px;
    width: auto;
    transition: opacity var(--transition);
  }

  .header__logo:hover img { opacity: 0.85; }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .header__nav-list {
    display: flex;
    list-style: none;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 248, 242, 0.82);
    transition: color var(--transition);
    position: relative;
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gradient-primary);
    border-radius: 2px;
    transition: width var(--transition);
  }

  .header__nav-link:hover,
  .header__nav-link.is-active {
    color: var(--color-text-light);
  }

  .header__nav-link:hover::after,
  .header__nav-link.is-active::after {
    width: 100%;
  }

  .header__cta {
    padding: 0.6rem 1.4rem;
    font-size: 0.72rem;
  }

  /* ====== Burger ====== */
  .header__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-right: 0.4rem;
    z-index: 3;
  }

  .header__burger span {
    display: block;
    width: 24px;
    height: 1.5px;
    background-color: var(--color-text-light);
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .header__burger.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .header__burger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .header__burger.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  @media (max-width: 1024px) {
    .header {
      padding: 0.7rem 1rem;
      padding-top: max(0.7rem, env(safe-area-inset-top));
    }
    .header.scrolled {
      padding-top: max(0.5rem, env(safe-area-inset-top));
      padding-bottom: 0.5rem;
    }

    .header__burger { display: flex; }

    /* Overlay plein écran */
    .header__nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100dvh;
      padding: 6rem 1.5rem 2.5rem;
      background-color: rgba(14, 6, 4, 0.92);
      backdrop-filter: blur(22px) saturate(160%);
      -webkit-backdrop-filter: blur(22px) saturate(160%);
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      gap: 2rem;
      overflow-y: auto;
      overscroll-behavior: contain;

      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
      z-index: 1;
    }

    .header__nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s;
    }

    .header__nav-list {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      width: 100%;
    }

    .header__nav-list li {
      width: 100%;
      text-align: center;
    }

    .header__nav-link {
      display: inline-block;
      font-size: 1.15rem;
      letter-spacing: 0.18em;
      padding: 0.5rem 1rem;
    }

    .header__cta {
      margin-top: 1rem;
      padding: 0.95rem 2.75rem;
      font-size: 0.85rem;
    }
  }

  /* Accessibilité : respecte la réduction des animations */
  @media (prefers-reduced-motion: reduce) {
    .header,
    .header__bar::before,
    .header__nav {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById('header')!;
  const burger = document.getElementById('burger')!;
  const nav    = document.getElementById('nav')!;

  /* Scroll → barre plus opaque. Lit window.scrollY de façon throttlée via rAF
     pour éviter les forced reflows sur les pages longues. */
  let scrollScheduled = false;
  const onScroll = () => {
    if (scrollScheduled) return;
    scrollScheduled = true;
    requestAnimationFrame(() => {
      scrollScheduled = false;
      header.classList.toggle('scrolled', window.scrollY > 40);
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  /* Check initial différé pour ne pas bloquer le rendu critique. */
  requestAnimationFrame(onScroll);

  const setMenu = (open: boolean) => {
    burger.classList.toggle('is-open', open);
    nav.classList.toggle('is-open', open);
    header.classList.toggle('menu-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    document.body.style.overflow = open ? 'hidden' : '';
  };

  /* Burger */
  burger.addEventListener('click', () => {
    setMenu(!burger.classList.contains('is-open'));
  });

  /* Fermer en cliquant sur un lien */
  nav.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });

  /* Fermer avec Échap */
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger.classList.contains('is-open')) setMenu(false);
  });

  /* Fermer si on repasse en desktop */
  const mq = window.matchMedia('(min-width: 1025px)');
  mq.addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>
