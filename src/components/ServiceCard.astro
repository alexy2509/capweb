---
export interface Props {
  icon:        string;
  title:       string;
  description: string;
  features?:   string[];
  price?:      string;
  href?:       string;
  featured?:   boolean;
}

const {
  icon,
  title,
  description,
  features = [],
  price,
  href = '/contact',
  featured = false,
} = Astro.props;
---

<article class={`service-card ${featured ? 'service-card--featured' : ''}`}>
  <div class="service-card__icon" aria-hidden="true">{icon}</div>
  <h3 class="service-card__title">{title}</h3>
  <p class="service-card__desc">{description}</p>

  {features.length > 0 && (
    <ul class="service-card__features">
      {features.map(f => (
        <li>
          <span class="service-card__check" aria-hidden="true">✦</span>
          {f}
        </li>
      ))}
    </ul>
  )}

  {price && <p class="service-card__price">{price}</p>}

  <a href={href} class={`btn ${featured ? 'btn-primary' : 'btn-outline'} service-card__cta`}>
    En savoir plus
  </a>
</article>

<style>
  .service-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md) var(--spacing-md) var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }

  .service-card:hover::before { transform: scaleX(1); }

  .service-card--featured {
    background: var(--gradient-warm);
    border: none;
    color: var(--color-text-light);
    box-shadow: 0 12px 40px rgba(255, 46, 126, 0.18);
  }

  .service-card--featured::before { display: none; }

  .service-card__icon {
    font-size: 2rem;
    line-height: 1;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .service-card--featured .service-card__icon {
    background: none;
    -webkit-text-fill-color: var(--color-text-light);
    color: var(--color-text-light);
  }

  .service-card__title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 400;
    color: inherit;
  }

  .service-card--featured .service-card__title { color: var(--color-text-light); }

  .service-card__desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    flex: 1;
  }

  .service-card--featured .service-card__desc { color: rgba(255, 248, 242, 0.85); }

  .service-card__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-top: 0.5rem;
  }

  .service-card--featured .service-card__features { color: rgba(255, 248, 242, 0.85); }

  .service-card__features li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .service-card__check {
    color: var(--color-primary);
    font-size: 0.6rem;
    flex-shrink: 0;
  }

  .service-card--featured .service-card__check { color: var(--color-text-light); }

  .service-card__price {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 500;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  .service-card--featured .service-card__price {
    border-top-color: rgba(255, 248, 242, 0.25);
    background: none;
    -webkit-text-fill-color: var(--color-text-light);
  }

  .service-card--featured .service-card__cta {
    background: var(--color-text-light);
    color: var(--color-text);
    border-color: transparent;
  }

  .service-card--featured .service-card__cta:hover {
    background: var(--color-text);
    color: var(--color-text-light);
  }

  .service-card__cta { margin-top: auto; }
</style>
