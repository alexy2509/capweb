---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  keywords?: string;
}

const {
  title,
  description,
  image = '/favicon.png',
  noindex = false,
  type = 'website',
  keywords,
} = Astro.props;

const SITE = Astro.site ?? new URL('https://capweb.pro');
const canonicalURL = new URL(Astro.url.pathname, SITE).href.replace(/\/$/, '') || SITE.href;
const ogImage = new URL(image, SITE).href;
const pageTitle = title.includes('CapWeb') ? title : `${title} | CapWeb`;
const isHome = Astro.url.pathname === '/';

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.origin}/#business`,
  name: 'CapWeb',
  alternateName: 'CapWeb · Création de sites internet',
  description: 'Agence web à Quimper, dans le Finistère. Création de sites internet sur-mesure pour artisans, commerçants, indépendants et PME en Bretagne.',
  url: SITE.origin,
  logo: `${SITE.origin}/logo.png`,
  image: `${SITE.origin}/favicon.png`,
  email: 'contact@capweb.pro',
  telephone: '+33781822821',
  priceRange: '€€',
  areaServed: [
    { '@type': 'City', name: 'Quimper' },
    { '@type': 'AdministrativeArea', name: 'Finistère' },
    { '@type': 'AdministrativeArea', name: 'Bretagne' },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Quimper',
    addressRegion: 'Bretagne',
    postalCode: '29000',
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 47.9960,
    longitude: -4.0972,
  },
  sameAs: ['https://www.instagram.com/capwebbuild'],
  serviceType: [
    'Création de site internet',
    'Site vitrine',
    'Site e-commerce',
    'Refonte de site web',
    'Référencement SEO local',
  ],
  founder: { '@type': 'Person', name: 'Alexy Beauvarlet' },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.origin}/#website`,
  url: SITE.origin,
  name: 'CapWeb',
  description: 'Création de sites internet à Quimper, Finistère, Bretagne',
  inLanguage: 'fr-FR',
  publisher: { '@id': `${SITE.origin}/#business` },
};
---

<!DOCTYPE html>
<html lang="fr-FR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0E0604" />
    <meta name="format-detection" content="telephone=yes" />

    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" href="/favicon.png?v=3" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="author" content="CapWeb" />

    <meta name="geo.region" content="FR-BRE" />
    <meta name="geo.placename" content="Quimper, Finistère, Bretagne" />
    <meta name="geo.position" content="47.9960;-4.0972" />
    <meta name="ICBM" content="47.9960, -4.0972" />

    <meta property="og:site_name"   content="CapWeb" />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:alt"   content="CapWeb · Création de sites internet à Quimper, Finistère, Bretagne" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:type"        content={type} />
    <meta property="og:locale"      content="fr_FR" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Précharge LCP : le logo en haut de page -->
    <link rel="preload" as="image" href="/logo.webp" type="image/webp" fetchpriority="high" />

    <!-- Polices : préconnexion + chargement non bloquant -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400;1,9..144,500&family=Inter:wght@300;400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400;1,9..144,500&family=Inter:wght@300;400;500;600;700&display=swap"
      />
    </noscript>

    {isHome && (
      <Fragment>
        <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
      </Fragment>
    )}
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>
