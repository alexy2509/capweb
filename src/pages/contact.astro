---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact"
  description="Contactez CapWeb pour votre projet web. Premier échange gratuit, devis sous 48h. Nous répondons à toutes vos questions sur nos offres de sites web sur-mesure."
>
  <NavBar />
  <main>

    <!-- ========== PAGE HERO ========== -->
    <section class="page-hero section-dark">
      <div class="container page-hero__inner">
        <p class="section-label">Parlons de votre projet</p>
        <div class="divider"></div>
        <h1>Démarrons<br /><em class="text-accent">ensemble</em></h1>
        <p class="page-hero__sub">
          Premier échange gratuit, sans engagement. Nous répondons sous 48h
          et vous envoyons un devis détaillé sous 48h.
        </p>
      </div>
    </section>

    <!-- ========== CONTACT ========== -->
    <section class="section">
      <div class="container contact-layout">

        <!-- Formulaire -->
        <div class="contact-main">
          <h2 class="contact-main__title">Votre message</h2>
          <p class="contact-main__sub">
            Décrivez votre projet avec le maximum de détails. Plus vous êtes précis,
            plus notre devis sera adapté à vos besoins.
          </p>
          <ContactForm />
        </div>

        <!-- Infos de contact -->
        <aside class="contact-sidebar">
          <div class="contact-info">
            <h3 class="contact-info__title">Coordonnées</h3>
            <address class="contact-info__list">
              <a href="mailto:alexy.beauvarlet@gmail.com" class="contact-info__item">
                <div class="contact-info__icon" aria-hidden="true">✉</div>
                <div>
                  <span class="contact-info__label">Email</span>
                  <span class="contact-info__value">alexy.beauvarlet@gmail.com</span>
                </div>
              </a>
              <a href="tel:+33781822821" class="contact-info__item">
                <div class="contact-info__icon" aria-hidden="true">✆</div>
                <div>
                  <span class="contact-info__label">Téléphone</span>
                  <span class="contact-info__value">+33 7 81 82 28 21</span>
                </div>
              </a>
              <a href="https://www.instagram.com/capwebbuild?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank" rel="noopener noreferrer" class="contact-info__item">
                <div class="contact-info__icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
                  </svg>
                </div>
                <div>
                  <span class="contact-info__label">Instagram</span>
                  <span class="contact-info__value">@capwebbuild</span>
                </div>
              </a>
              <div class="contact-info__item">
                <div class="contact-info__icon" aria-hidden="true">◎</div>
                <div>
                  <span class="contact-info__label">Localisation</span>
                  <span class="contact-info__value">France (remote)</span>
                </div>
              </div>
              <div class="contact-info__item">
                <div class="contact-info__icon" aria-hidden="true">◷</div>
                <div>
                  <span class="contact-info__label">Délai de réponse</span>
                  <span class="contact-info__value">Sous 48h</span>
                </div>
              </div>
            </address>
          </div>

          <div class="contact-promise">
            <p class="section-label">Notre engagement</p>
            <ul class="contact-promise__list">
              {[
                'Devis gratuit et sans engagement',
                'Réponse sous 48h garantie',
                'Échange téléphonique offert',
                'Accompagnement de A à Z',
                'Prix fixe, aucune surprise',
              ].map(item => (
                <li>
                  <span class="contact-promise__check" aria-hidden="true">✦</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="contact-faq">
            <h3 class="contact-faq__title">Questions fréquentes</h3>
            {[
              { q: 'Quel est votre délai moyen ?', a: 'Un site vitrine est livré sous 1 semaine. Un e-commerce sous 2 semaines selon la complexité. Les refontes sont livrées sous 1 semaine et la mise en place SEO sous 1 à 2 semaines.' },
              { q: 'Proposez-vous des facilités de paiement ?', a: 'Oui. Nous proposons un paiement en 3 fois : 40% à la signature, 40% à la validation du design, 20% à la livraison.' },
              { q: 'Puis-je modifier mon site après livraison ?', a: 'Absolument. Nous restons disponibles pour toute modification.' },
            ].map(item => (
              <details class="faq-item">
                <summary class="faq-item__q">{item.q}</summary>
                <p class="faq-item__a">{item.a}</p>
              </details>
            ))}
          </div>
        </aside>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  /* Page hero */
  .page-hero {
    padding: 9rem 0 var(--spacing-xl);
  }

  .page-hero__inner h1 { margin: var(--spacing-sm) 0; }

  .page-hero__sub {
    max-width: 520px;
    color: rgba(247,244,238,0.6);
    margin-top: var(--spacing-sm);
    font-size: 1rem;
    line-height: 1.8;
  }

  /* Contact layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .contact-main__title {
    font-family: var(--font-heading);
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .contact-main__sub {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin-bottom: var(--spacing-md);
    line-height: 1.7;
  }

  /* Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    position: sticky;
    top: 7rem;
  }

  .contact-info,
  .contact-promise,
  .contact-faq {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
  }

  .contact-info__title,
  .contact-faq__title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--spacing-sm);
  }

  .contact-info__list {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .contact-info__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    text-decoration: none;
    transition: color var(--transition);
  }

  a.contact-info__item:hover { color: var(--color-accent); }

  .contact-info__icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .contact-info__label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.1rem;
  }

  .contact-info__value {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
  }

  /* Promise */
  .contact-promise__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: var(--spacing-xs);
  }

  .contact-promise__list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .contact-promise__check {
    color: var(--color-accent);
    font-size: 0.55rem;
    flex-shrink: 0;
  }

  /* FAQ */
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--spacing-xs);
    margin-bottom: var(--spacing-xs);
  }

  .faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .faq-item__q {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    padding: 0.5rem 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    transition: color var(--transition);
  }

  .faq-item__q::-webkit-details-marker { display: none; }

  .faq-item__q::after {
    content: '+';
    color: var(--color-accent);
    font-size: 1.1rem;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  details[open] .faq-item__q::after { transform: rotate(45deg); }

  .faq-item__q:hover { color: var(--color-accent); }

  .faq-item__a {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    padding-bottom: 0.5rem;
  }

  @media (max-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
    .contact-sidebar { position: static; }
  }
</style>
