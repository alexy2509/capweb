---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

const offers = [
  { icon: '◈', title: 'Site vitrine',   tagline: 'Une présence en ligne élégante qui inspire confiance.',     href: '/services#vitrine'   },
  { icon: '◉', title: 'E-commerce',     tagline: 'Une boutique fluide qui transforme vos visiteurs en clients.', href: '/services#ecommerce' },
  { icon: '◌', title: 'Refonte',        tagline: 'Redonner souffle, rapidité et style à votre site existant.',  href: '/services#refonte'   },
  { icon: '◎', title: 'Référencement',  tagline: 'Être trouvé sur Google par les bonnes personnes.',            href: '/services#seo'       },
];
---

<BaseLayout
  title="Création de site internet à Quimper, Finistère & Bretagne · CapWeb"
  description="CapWeb crée facilement des sites internet professionnels et pas chers pour les artisans, commerçants et entreprises de Quimper, du Finistère et de toute la Bretagne. Devis gratuit sous 48h."
  keywords="création site internet Quimper, site web Finistère, agence web Bretagne, création site internet artisan, site internet pas cher Bretagne, création site web entreprise Quimper"
>
  <NavBar />
  <main>

    <!-- ========== HERO ========== -->
    <Hero />

    <!-- ========== OFFRES (aperçu épuré) ========== -->
    <section class="section section-alt" id="services" aria-labelledby="services-title">
      <div class="container">
        <header class="section-header centered">
          <p class="section-label">Ce que nous faisons</p>
          <div class="divider divider-center"></div>
          <h2 id="services-title">Nos offres</h2>
          <p class="section-subtitle">
            Quatre façons de faire grandir votre présence en ligne.
          </p>
        </header>

        <ul class="offers-grid" role="list">
          {offers.map(o => (
            <li class="offer-tile">
              <a href={o.href} class="offer-tile__link">
                <span class="offer-tile__icon" aria-hidden="true">{o.icon}</span>
                <h3 class="offer-tile__title">{o.title}</h3>
                <p class="offer-tile__tagline">{o.tagline}</p>
                <span class="offer-tile__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="services-cta">
          <a href="/services" class="btn btn-outline">Découvrir nos offres en détail</a>
        </div>
      </div>
    </section>

    <!-- ========== POURQUOI CAPWEB ========== -->
    <section class="section section-dark" aria-labelledby="why-title">
      <div class="container">
        <header class="section-header centered">
          <p class="section-label">Pourquoi nous choisir</p>
          <div class="divider divider-center"></div>
          <h2 id="why-title">L'excellence au service<br /><em class="text-accent">de votre croissance</em></h2>
        </header>
        <div class="why-grid">
          {[
            { num: '01', title: 'Design premium', text: 'Chaque site est une œuvre unique pensée pour votre marque. Pas de template générique, un design qui vous ressemble.' },
            { num: '02', title: 'Performance & SEO', text: 'Sites ultra-rapides, optimisés pour Google et vos utilisateurs. Score Lighthouse > 90 garanti à la livraison.' },
            { num: '03', title: 'Accompagnement total', text: 'De la conception à la mise en ligne, nous sommes à vos côtés. Formation incluse, support réactif, pas d\'abandon.' },
            { num: '04', title: 'Résultats mesurables', text: 'Nous suivons les performances et ajustons la stratégie. Votre succès est notre priorité, pas seulement la livraison.' },
            { num: '05', title: 'Délais respectés', text: 'Nos processus rodés nous permettent de tenir nos engagements. Vous savez toujours où en est votre projet.' },
            { num: '06', title: 'Transparence totale', text: 'Devis détaillé, échanges clairs, aucune surprise. Vous choisissez en connaissance de cause, nous livrons ce que nous promettons.' },
          ].map(item => (
            <div class="why-item">
              <span class="why-item__num">{item.num}</span>
              <div>
                <h3 class="why-item__title">{item.title}</h3>
                <p class="why-item__text">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========== CTA FINAL ========== -->
    <section class="section cta-section" aria-labelledby="cta-title">
      <div class="container cta-inner">
        <div class="cta-content">
          <p class="section-label">Passez à l'action</p>
          <div class="divider"></div>
          <h2 id="cta-title">Prêt à transformer<br /><em class="text-accent">votre présence en ligne ?</em></h2>
          <p class="cta-text">
            Discutons de votre projet. Premier échange gratuit,<br />devis sous 48h, sans engagement.
          </p>
          <div class="cta-buttons">
            <a href="/contact" class="btn btn-primary">Demander un devis gratuit</a>
            <a href="tel:+33781822821" id="call-btn" class="btn btn-outline">Nous appeler</a>
          </div>
        </div>
        <div class="cta-decoration" aria-hidden="true">
          <div class="cta-orb">
            <svg class="cta-orb__arc" viewBox="0 0 100 100">
              <defs>
                <linearGradient id="orbArcGrad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%"  stop-color="#FF6B2C" stop-opacity="0" />
                  <stop offset="55%" stop-color="#FF6B2C" stop-opacity="0.85" />
                  <stop offset="100%" stop-color="#FF2E7E" stop-opacity="1" />
                </linearGradient>
              </defs>
              <circle cx="50" cy="50" r="46" stroke="url(#orbArcGrad)" />
            </svg>

            <span class="cta-orb__symbol cta-orb__symbol--a">&lt;/&gt;</span>
            <span class="cta-orb__symbol cta-orb__symbol--b">{ }</span>
            <span class="cta-orb__symbol cta-orb__symbol--c">01</span>
            <span class="cta-orb__symbol cta-orb__symbol--d">;</span>
            <span class="cta-orb__symbol cta-orb__symbol--e">[ ]</span>

            <span class="cta-orb__particle cta-orb__particle--p1"></span>
            <span class="cta-orb__particle cta-orb__particle--p2"></span>
            <span class="cta-orb__particle cta-orb__particle--p3"></span>
            <span class="cta-orb__particle cta-orb__particle--p4"></span>

            <div class="cta-orb__window" id="cta-orb-window">
              <span class="cta-orb__dot"></span>
              <span class="cta-orb__dot"></span>
              <span class="cta-orb__dot"></span>
              <div class="cta-orb__code" id="cta-orb-code">
                <span class="cta-orb__line cta-orb__line--1"></span>
                <span class="cta-orb__line cta-orb__line--2"></span>
                <span class="cta-orb__line cta-orb__line--3"></span>
              </div>
            </div>
          </div>
        </div>

        <script is:inline>
          /* L'orb code est sous le fold : on n'initialise qu'à la visibilité, en idle. */
          (() => {
            const code = document.getElementById('cta-orb-code');
            if (!code) return;
            const lines = code.querySelectorAll('.cta-orb__line');

            const snippets = [
              ['<i>const</i> site = <b>build</b>();', '<i>const</i> ux   = <b>premium</b>;', '&gt; deploy<span class="cta-orb__cursor">_</span>'],
              ['<i>npm</i> install capweb',           '<i>npm</i> run <b>shine</b>',         '&gt; ready<span class="cta-orb__cursor">_</span>'],
              ['<i>git</i> commit -m <b>"ux"</b>',    '<i>git</i> push origin',              '&gt; live<span class="cta-orb__cursor">_</span>'],
              ['&lt;Site speed=<b>"fast"</b>/&gt;',   '&lt;SEO local /&gt;',                 '&gt; indexed<span class="cta-orb__cursor">_</span>'],
              ['<i>function</i> craft() {',           '  <i>return</i> <b>magic</b>;',       '&gt; shipped<span class="cta-orb__cursor">_</span>'],
              ['<i>let</i> dream = <b>code</b>()',    '<i>let</i> client = <b>happy</b>',    '&gt; done<span class="cta-orb__cursor">_</span>'],
              ['<i>brew</i> install seo',             '<i>brew</i> update --all',            '&gt; ranked<span class="cta-orb__cursor">_</span>'],
            ];

            let last = -1;
            let interval = null;
            const swap = () => {
              let i;
              do { i = Math.floor(Math.random() * snippets.length); } while (i === last && snippets.length > 1);
              last = i;
              const [a, b, c] = snippets[i];
              code.classList.remove('is-typing');
              void code.offsetWidth;
              lines[0].innerHTML = a;
              lines[1].innerHTML = b;
              lines[2].innerHTML = c;
              code.classList.add('is-typing');
            };

            const start = () => { if (interval) return; swap(); interval = setInterval(swap, 5400); };
            const stop  = () => { if (interval) { clearInterval(interval); interval = null; } };

            const observer = new IntersectionObserver((entries) => {
              entries.forEach((e) => (e.isIntersecting ? start() : stop()));
            }, { rootMargin: '200px' });
            observer.observe(code);
          })();
        </script>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  /* Section subtitle */
  .section-subtitle {
    max-width: 520px;
    margin: var(--spacing-sm) auto 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .services-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--spacing-lg);
  }

  /* Offres épurées · aperçu sur la page d'accueil */
  .offers-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-sm);
  }

  .offer-tile { margin: 0; }

  .offer-tile__link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: var(--spacing-md);
    border: 1px solid rgba(255, 107, 44, 0.18);
    border-radius: var(--radius-lg);
    background: rgba(255, 248, 242, 0.02);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transition), transform var(--transition), background-color var(--transition);
    position: relative;
    overflow: hidden;
  }

  .offer-tile__link::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--gradient-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .offer-tile__link:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 107, 44, 0.45);
    background: rgba(255, 107, 44, 0.04);
  }

  .offer-tile__link:hover::before { transform: scaleX(1); }

  .offer-tile__icon {
    font-size: 1.6rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1;
  }

  .offer-tile__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 400;
    margin: 0;
    color: var(--color-text);
  }

  .offer-tile__tagline {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
    flex: 1;
  }

  .offer-tile__arrow {
    align-self: flex-end;
    font-size: 1.1rem;
    color: var(--color-primary);
    opacity: 0.5;
    transition: transform var(--transition), opacity var(--transition);
  }

  .offer-tile__link:hover .offer-tile__arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .offers-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .offers-grid { grid-template-columns: 1fr; }
  }

  /* Why grid */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
  }

  .why-item {
    display: flex;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
    border: 1px solid rgba(255, 107, 44, 0.18);
    border-radius: var(--radius-lg);
    background: rgba(255, 248, 242, 0.02);
    transition: border-color var(--transition), background-color var(--transition), transform var(--transition);
  }

  .why-item:hover {
    border-color: rgba(255, 107, 44, 0.4);
    background: rgba(255, 107, 44, 0.05);
    transform: translateY(-3px);
  }

  .why-item__num {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-style: italic;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    flex-shrink: 0;
    line-height: 1.2;
  }

  .why-item__title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }

  .why-item__text {
    font-size: 0.88rem;
    color: rgba(255, 248, 242, 0.6);
    line-height: 1.7;
  }

  /* Portfolio header */
  .portfolio-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: var(--spacing-lg);
    gap: var(--spacing-md);
  }

  /* CTA final */
  .cta-section {
    background-color: var(--color-bg-alt);
    overflow: hidden;
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--spacing-lg);
    align-items: center;
  }

  .cta-text {
    color: var(--color-text-muted);
    margin: var(--spacing-sm) 0 var(--spacing-md);
    line-height: 1.7;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .cta-decoration {
    position: relative;
    width: 220px;
    height: 220px;
    flex-shrink: 0;
  }

  .cta-orb {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .cta-orb__arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 80 240;
    animation: orbArcSpin 9s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  /* Mini fenêtre éditeur de code au centre */
  .cta-orb__window {
    position: relative;
    width: 158px;
    padding: 22px 14px 12px;
    border-radius: 10px;
    background: linear-gradient(160deg, rgba(20, 10, 7, 0.92) 0%, rgba(36, 14, 22, 0.92) 100%);
    border: 1px solid rgba(255, 107, 44, 0.35);
    box-shadow:
      0 0 24px rgba(255, 46, 126, 0.25),
      inset 0 1px 0 rgba(255, 248, 242, 0.05);
    animation: orbBreathe 6s ease-in-out infinite;
  }

  .cta-orb__dot {
    position: absolute;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .cta-orb__dot:nth-of-type(1) { left: 12px; background: #FF5F57; }
  .cta-orb__dot:nth-of-type(2) { left: 24px; background: #FFB347; }
  .cta-orb__dot:nth-of-type(3) { left: 36px; background: #FF2E7E; }

  .cta-orb__code {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
    font-size: 0.62rem;
    line-height: 1.45;
    color: rgba(255, 248, 242, 0.85);
    overflow: hidden;
  }

  .cta-orb__line {
    white-space: nowrap;
    overflow: hidden;
    border-right: 1.5px solid transparent;
  }

  .cta-orb__line i { color: #FF6B2C; font-style: normal; }
  .cta-orb__line b { color: #FF2E7E; font-weight: 600; }

  .cta-orb__code .cta-orb__line { width: 0; opacity: 0; }

  .cta-orb__code.is-typing .cta-orb__line--1 { animation: typeOnce 1.4s steps(22, end) forwards; }
  .cta-orb__code.is-typing .cta-orb__line--2 { animation: typeOnce 1.4s steps(22, end) forwards; animation-delay: 1.2s; }
  .cta-orb__code.is-typing .cta-orb__line--3 { animation: typeOnce 1.4s steps(22, end) forwards; animation-delay: 2.4s; }

  .cta-orb__cursor {
    color: #FF2E7E;
    font-weight: 700;
    animation: orbBlink 1.05s steps(2, end) infinite;
  }

  /* Petits symboles de code qui orbitent autour */
  .cta-orb__symbol {
    position: absolute;
    font-family: 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255, 107, 44, 0.85);
    text-shadow: 0 0 10px rgba(255, 107, 44, 0.4);
    top: 50%;
    left: 50%;
    margin: -0.5em 0 0 -1em;
    transform-origin: 0 0;
  }

  .cta-orb__symbol--a { animation: orbOrbit 14s linear infinite; }
  .cta-orb__symbol--b { animation: orbOrbit 18s linear infinite reverse; animation-delay: -6s; color: rgba(255, 46, 126, 0.85); }
  .cta-orb__symbol--c { animation: orbOrbit 22s linear infinite; animation-delay: -10s; }
  .cta-orb__symbol--d { animation: orbOrbit 26s linear infinite reverse; animation-delay: -3s; font-size: 0.85rem; color: rgba(255, 107, 44, 0.7); }
  .cta-orb__symbol--e { animation: orbOrbit 30s linear infinite; animation-delay: -16s; font-size: 0.65rem; color: rgba(255, 46, 126, 0.7); }

  /* Particules de codage qui tournent */
  .cta-orb__particle {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    pointer-events: none;
    transform-origin: 0 0;
  }
  .cta-orb__particle--p1 {
    width: 4px; height: 4px; margin: -2px 0 0 -2px;
    background: #FF6B2C;
    box-shadow: 0 0 8px rgba(255, 107, 44, 0.8);
    animation: orbOrbit 8s linear infinite;
    animation-delay: -2s;
  }
  .cta-orb__particle--p2 {
    width: 3px; height: 3px; margin: -1.5px 0 0 -1.5px;
    background: #FF2E7E;
    box-shadow: 0 0 6px rgba(255, 46, 126, 0.7);
    animation: orbOrbit 11s linear infinite reverse;
    animation-delay: -5s;
  }
  .cta-orb__particle--p3 {
    width: 2px; height: 2px; margin: -1px 0 0 -1px;
    background: rgba(255, 248, 242, 0.85);
    box-shadow: 0 0 5px rgba(255, 179, 71, 0.7);
    animation: orbOrbitFar 13s linear infinite;
    animation-delay: -8s;
  }
  .cta-orb__particle--p4 {
    width: 5px; height: 1px; border-radius: 1px;
    margin: -0.5px 0 0 -2.5px;
    background: linear-gradient(90deg, transparent, #FF6B2C, transparent);
    animation: orbOrbitFar 9s linear infinite reverse;
    animation-delay: -1s;
  }

  @keyframes orbArcSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes orbBreathe {
    0%, 100% {
      box-shadow: 0 0 22px rgba(255, 46, 126, 0.22), inset 0 1px 0 rgba(255, 248, 242, 0.05);
    }
    50% {
      box-shadow: 0 0 34px rgba(255, 107, 44, 0.32), inset 0 1px 0 rgba(255, 248, 242, 0.08);
    }
  }

  @keyframes typeOnce {
    0%   { width: 0;    opacity: 1; border-right-color: #FF2E7E; }
    99%  { width: 100%; opacity: 1; border-right-color: #FF2E7E; }
    100% { width: 100%; opacity: 1; border-right-color: transparent; }
  }

  @keyframes orbOrbit {
    from { transform: rotate(0deg)   translateX(102px) rotate(0deg); }
    to   { transform: rotate(360deg) translateX(102px) rotate(-360deg); }
  }

  @keyframes orbOrbitFar {
    from { transform: rotate(0deg)   translateX(108px) rotate(0deg); }
    to   { transform: rotate(360deg) translateX(108px) rotate(-360deg); }
  }

  @keyframes orbBlink {
    0%, 49%   { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-orb__arc,
    .cta-orb__window,
    .cta-orb__line,
    .cta-orb__symbol,
    .cta-orb__particle,
    .cta-orb__cursor { animation: none !important; }
    .cta-orb__line { opacity: 1 !important; width: 100% !important; }
  }

  @media (max-width: 1024px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
    .cta-inner { grid-template-columns: 1fr; }
    .cta-decoration { display: none; }
  }

  @media (max-width: 768px) {
    .why-grid { grid-template-columns: 1fr; }
    .portfolio-header { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  const callBtn = document.getElementById('call-btn');
  if (callBtn) {
    callBtn.addEventListener('click', (e) => {
      const ok = window.confirm('Confirmer l\u2019appel au +33 7 81 82 28 21 ?');
      if (!ok) e.preventDefault();
    });
  }
</script>
