      <!-- ============================ ÉTAPE 3 · LA NOTE /10 ============================ -->
      <section class="scene" id="love">
        <div class="wrap" style="text-align:center;">
          <p class="reveal overline">Étape 3 · le verdict</p>
          <h2 class="reveal" style="font-family:var(--title); font-weight:400; font-size:2.3rem; margin:10px 0 8px; color:var(--creme);">Question sérieuse.</h2>
          <p class="reveal sub" style="max-width:330px; margin:0 auto;">
            Sur une échelle de 1 à 10… tu m'aimes combien&nbsp;? Sois honnête. Ou généreuse. 😏
          </p>

          <div class="reveal love-scale" id="love-scale">
            <button class="love-chip" data-love="1">1</button>
            <button class="love-chip" data-love="2">2</button>
            <button class="love-chip" data-love="3">3</button>
            <button class="love-chip" data-love="4">4</button>
            <button class="love-chip" data-love="5">5</button>
            <button class="love-chip" data-love="6">6</button>
            <button class="love-chip" data-love="7">7</button>
            <button class="love-chip" data-love="8">8</button>
            <button class="love-chip" data-love="9">9</button>
            <button class="love-chip" data-love="10">10</button>
          </div>

          <p class="reveal tiny" style="margin-top:18px;">(en dessous de 8, je boude sur tout le trajet. Juste pour info.)</p>
          <div style="text-align:center; margin-top:10px;">
            <a class="btn-ghost" href="#calendar" data-goto="calendar" role="button">‹ Revenir à la date</a>
