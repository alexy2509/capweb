          <h2 class="reveal" style="font-family:var(--title); font-weight:400; font-size:2.5rem; margin:12px 0 6px; color:var(--creme);">
            Alors ce sera<br/>cette soirée&nbsp;✨
          </h2>
          <p class="reveal sub" style="max-width:320px; margin:6px auto 0;">
            Tu viens de rendre quelqu'un très heureux. Le reste, c'est mon affaire — toi, tu n'as qu'à te faire belle et te laisser guider.
          </p>

          <div class="reveal recap">
            <div class="l">Notre rendez-vous</div>
            <div class="v" id="recap-value">—</div>
          </div>

          <div class="reveal cta-stack" style="margin-top:24px;">
            <a class="btn" id="reply-btn" href="#" style="display:none;">Dis-moi oui&nbsp; 💌</a>
            <p class="sub" id="reply-hint" style="max-width:300px;">Garde cet écran… et viens me le montrer avec ton plus beau sourire. 😘</p>
            <button class="btn-ghost" data-goto="choices">‹ Changer d'avis</button>
          </div>
          <p class="reveal script" style="margin-top:26px; font-size:1.4rem; opacity:0.9;">Je t'aime.</p>
        </div>
      </section>

    </main>

    <script is:inline>
      /* ============================================================
         CONFIG — à personnaliser par Alexy
         → Mets ton numéro WhatsApp au format international (sans +, ni espaces)
           pour activer le bouton « Dis-moi oui » qui t'enverra son choix.
           Exemple : '33612345678'. Laisse vide pour désactiver le bouton.
      ============================================================ */
      var CONFIG = {
        prenom: 'Marie',
        whatsapp: '' // ex: '336XXXXXXXX'
      };

      (function () {
        var scenes = Array.prototype.slice.call(document.querySelectorAll('.scene'));
        var current = document.querySelector('.scene.is-active');

        function show(id) {
          var next = document.getElementById(id);
          if (!next || next === current) return;
          if (current) {
            current.classList.remove('is-active');
            // relance les animations de révélation à la prochaine activation
            current.querySelectorAll('.reveal').forEach(function (el) {
              el.style.animation = 'none'; void el.offsetWidth; el.style.animation = '';
            });
          }
          next.classList.add('is-active');
          next.scrollTop = 0;
          current = next;
          if (history && history.replaceState) history.replaceState(null, '', '#' + id);
        }

        // Navigation par attributs data-goto
        document.addEventListener('click', function (e) {
          var t = e.target.closest('[data-goto]');
          if (t) { e.preventDefault(); show(t.getAttribute('data-goto')); return; }

          // Choix d'une soirée
          var c = e.target.closest('[data-choose]');
          if (c) {
            e.preventDefault();
            var choix = c.getAttribute('data-choose');
            document.getElementById('recap-value').textContent = choix;

            var msg = 'Coucou 💕 J\'ai ouvert ton invitation… et je choisis : ' + choix + ' ! ';
            var btn = document.getElementById('reply-btn');
            var hint = document.getElementById('reply-hint');
            if (CONFIG.whatsapp) {
              btn.href = 'https://wa.me/' + CONFIG.whatsapp + '?text=' + encodeURIComponent(msg);
              btn.style.display = '';
              hint.style.display = 'none';
            }
            show('chosen');
            celebrate();
          }
        });

        // Support du bouton retour navigateur via le hash
        window.addEventListener('popstate', function () {
          var id = (location.hash || '#intro').slice(1);
          if (document.getElementById(id)) show(id);
        });

        /* ---------- Pétales flottants ---------- */
        var petals = document.getElementById('petals');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (petals && !reduce) {
          for (var i = 0; i < 14; i++) {
            var p = document.createElement('span');
            p.className = 'petal';
            var size = 8 + Math.random() * 12;
            p.style.left = (Math.random() * 100) + 'vw';
            p.style.width = size + 'px';
            p.style.height = size + 'px';
            p.style.animationDuration = (11 + Math.random() * 12) + 's';
            p.style.animationDelay = (-Math.random() * 16) + 's';
            p.style.opacity = 0;
            if (Math.random() > 0.5) {
              p.style.background = 'linear-gradient(140deg, #f3d8a8, #e3b579)';
            }
            petals.appendChild(p);
          }
        }

        /* ---------- Confettis / cœurs à la confirmation ---------- */
        function celebrate() {
          if (reduce) return;
          var burst = document.getElementById('burst');
          if (!burst) return;
          var colors = ['#f3d8a8', '#e3b579', '#e9b8bd', '#d98a94', '#63b3b0'];
          for (var i = 0; i < 46; i++) {
            var c = document.createElement('span');
            c.className = 'confetti';
            var left = 50 + (Math.random() * 40 - 20);
            c.style.left = left + 'vw';
            c.style.top = '42vh';
            c.style.background = colors[i % colors.length];
            if (Math.random() > 0.6) c.style.borderRadius = '50%';
            var dx = (Math.random() * 2 - 1) * 60;
            var dy = -(30 + Math.random() * 55);
            var rot = (Math.random() * 720 - 360);
            var dur = 1100 + Math.random() * 900;
            burst.appendChild(c);
            (function (el, dx, dy, rot, dur) {
              el.animate([
                { transform: 'translate(0,0) rotate(0deg)', opacity: 1 },
                { transform: 'translate(' + dx + 'vw,' + dy + 'vh) rotate(' + rot + 'deg)', opacity: 1, offset: 0.7 },
                { transform: 'translate(' + (dx * 1.2) + 'vw,' + (dy + 70) + 'vh) rotate(' + (rot * 1.4) + 'deg)', opacity: 0 }
              ], { duration: dur, easing: 'cubic-bezier(.2,.7,.3,1)', fill: 'forwards' });
            })(c, dx, dy, rot, dur);
            setTimeout((function (el) { return function () { el.remove(); }; })(c), dur + 100);
          }
        }

        // Personnalise le prénom si modifié dans CONFIG
        if (CONFIG.prenom && CONFIG.prenom !== 'Marie') {
          var h1 = document.querySelector('#intro .display');
          if (h1) h1.textContent = CONFIG.prenom;
        }

        // Ouverture directe sur une scène via le hash (utile pour tester)
        if (location.hash && document.getElementById(location.hash.slice(1))) {
          show(location.hash.slice(1));
        }
      })();
    </script>
  </body>
</html>
