      <!-- ============================ CONFIRMATION + ENVOI ============================ -->
      <section class="scene" id="chosen">
        <div class="wrap" style="text-align:center;">
          <div class="reveal halo">
            <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
              <circle cx="60" cy="60" r="46" stroke="url(#hg2)" stroke-width="1.5" opacity="0.5"/>
              <path d="M60 92s-26-16-33-32C22 47 27 37 37 37c6.6 0 11 4 14 8 3-4 7.4-8 14-8 10 0 15 10 10 23-7 16-15 32-15 32z" fill="url(#hg2)"/>
              <defs><linearGradient id="hg2" x1="0" y1="0" x2="120" y2="120"><stop stop-color="#f3d8a8"/><stop offset="1" stop-color="#d98a94"/></linearGradient></defs>
            </svg>
          </div>
          <p class="reveal overline">C'est plié</p>
          <h2 class="reveal" style="font-family:var(--title); font-weight:400; font-size:2.5rem; margin:12px 0 6px; color:var(--creme);">
            Rendez-vous pris.&nbsp;💫
          </h2>
          <p class="reveal sub" style="max-width:330px; margin:6px auto 0;">
            Tu viens de me rendre insupportablement heureux. La résa, le timing, la surprise — c'est pour ma pomme. Toi, tu te fais belle.
          </p>

          <div class="reveal recap">
            <div class="rc-row"><span class="l">Où</span><span class="v" id="rc-place">—</span></div>
            <div class="rc-row"><span class="l">Quand</span><span class="v" id="rc-date">—</span></div>
            <div class="rc-row"><span class="l">Elle m'aime</span><span class="v" id="rc-love">—</span></div>
          </div>

          <div class="reveal cta-stack" style="margin-top:24px;">
            <a class="btn" id="send-btn" href="#" role="button">Envoyer ma réponse à Alexy&nbsp; 💌</a>
            <p class="sub" style="max-width:310px;">Ça ouvre ton appli mail avec tout de pré-rempli — tu n'as plus qu'à appuyer sur <em>Envoyer</em>. Ensuite, c'est à moi de jouer. 😘</p>
            <a class="btn-ghost" href="#choices" data-goto="choices" role="button">‹ Tout recommencer</a>
          </div>
          <p class="reveal script" style="margin-top:26px; font-size:1.4rem; opacity:0.9;">Je t'aime. (oui, même si tu as mis 7.)</p>
        </div>
      </section>

    </main>

    <script is:inline>
      /* ============================================================
         CONFIG — la réponse de Marie part par mail à cette adresse.
      ============================================================ */
      var CONFIG = {
        prenom: 'Marie',
        email: 'alexy.beauvarlet@gmail.com'
      };

      (function () {
        var current = document.querySelector('.scene.is-active');
        var state = { place: '', date: '', love: '' };

        function show(id) {
          var next = document.getElementById(id);
          if (!next || next === current) return;
          if (current) {
            current.classList.remove('is-active');
            current.querySelectorAll('.reveal').forEach(function (el) {
              el.style.animation = 'none'; void el.offsetWidth; el.style.animation = '';
            });
          }
          next.classList.add('is-active');
          next.scrollTop = 0;
          current = next;
          if (history && history.replaceState) history.replaceState(null, '', '#' + id);
        }

        function buildRecap() {
          document.getElementById('rc-place').textContent = state.place || '—';
          document.getElementById('rc-date').textContent = state.date || '—';
          document.getElementById('rc-love').textContent = state.love ? (state.love + ' / 10') : '—';

          var subject = 'C\'est décidé 💕 notre soirée';
          var lignes = [
            'Coucou mon amour,',
            '',
            'C\'est bon, tu m\'as convaincue (enfin… tu m\'as convoquée 😏). Voici ma réponse :',
            '',
            '• Où : ' + state.place,
            '• Quand : ' + state.date,
            '• Et sur une échelle de 1 à 10, je t\'aime : ' + state.love + '/10',
            '',
            'À très vite. 😘',
            'Marie'
          ];
          var body = lignes.join('\n');
          var href = 'mailto:' + CONFIG.email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
          document.getElementById('send-btn').setAttribute('href', href);
        }

        document.addEventListener('click', function (e) {
          // Navigation simple
          var g = e.target.closest('[data-goto]');
          if (g) { e.preventDefault(); show(g.getAttribute('data-goto')); return; }

          // Choix de l'endroit → étape date
          var c = e.target.closest('[data-choose]');
          if (c) {
            e.preventDefault();
            state.place = c.getAttribute('data-choose').replace(/&amp;/g, '&');
            show('calendar');
            return;
          }

          // Choix du jour → étape note
          var d = e.target.closest('[data-date]');
          if (d) {
            e.preventDefault();
            document.querySelectorAll('#cal-grid .day.selected').forEach(function (x) { x.classList.remove('selected'); });
            d.classList.add('selected');
            state.date = d.getAttribute('data-date');
            setTimeout(function () { show('love'); }, 340);
            return;
          }

          // Choix de la note → confirmation + mail
          var l = e.target.closest('[data-love]');
          if (l) {
            e.preventDefault();
            document.querySelectorAll('#love-scale .love-chip.selected').forEach(function (x) { x.classList.remove('selected'); });
            l.classList.add('selected');
            state.love = l.getAttribute('data-love');
            buildRecap();
            setTimeout(function () { show('chosen'); celebrate(); }, 340);
            return;
          }
        });

        window.addEventListener('popstate', function () {
          var id = (location.hash || '#intro').slice(1);
          if (document.getElementById(id)) show(id);
        });

        /* Pétales flottants */
        var petals = document.getElementById('petals');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (petals && !reduce) {
          for (var i = 0; i < 14; i++) {
            var p = document.createElement('span');
            p.className = 'petal';
            var size = 8 + Math.random() * 12;
            p.style.left = (Math.random() * 100) + 'vw';
            p.style.width = size + 'px'; p.style.height = size + 'px';
            p.style.animationDuration = (11 + Math.random() * 12) + 's';
            p.style.animationDelay = (-Math.random() * 16) + 's';
            if (Math.random() > 0.5) p.style.background = 'linear-gradient(140deg, #f3d8a8, #e3b579)';
            petals.appendChild(p);
          }
        }

        /* Confettis à la confirmation */
        function celebrate() {
          if (reduce) return;
          var burst = document.getElementById('burst');
          if (!burst) return;
          var colors = ['#f3d8a8', '#e3b579', '#e9b8bd', '#d98a94', '#63b3b0'];
          for (var i = 0; i < 46; i++) {
            var c = document.createElement('span');
            c.className = 'confetti';
            c.style.left = (50 + (Math.random() * 40 - 20)) + 'vw';
            c.style.top = '42vh';
            c.style.background = colors[i % colors.length];
            if (Math.random() > 0.6) c.style.borderRadius = '50%';
            var dx = (Math.random() * 2 - 1) * 60;
            var dy = -(30 + Math.random() * 55);
            var rot = (Math.random() * 720 - 360);
            var dur = 1100 + Math.random() * 900;
            burst.appendChild(c);
            (function (el, dx, dy, rot, dur) {
              el.animate([
                { transform: 'translate(0,0) rotate(0deg)', opacity: 1 },
                { transform: 'translate(' + dx + 'vw,' + dy + 'vh) rotate(' + rot + 'deg)', opacity: 1, offset: 0.7 },
                { transform: 'translate(' + (dx * 1.2) + 'vw,' + (dy + 70) + 'vh) rotate(' + (rot * 1.4) + 'deg)', opacity: 0 }
              ], { duration: dur, easing: 'cubic-bezier(.2,.7,.3,1)', fill: 'forwards' });
            })(c, dx, dy, rot, dur);
            setTimeout((function (el) { return function () { el.remove(); }; })(c), dur + 100);
          }
        }

        if (CONFIG.prenom && CONFIG.prenom !== 'Marie') {
          var h1 = document.querySelector('#intro .display');
          if (h1) h1.textContent = CONFIG.prenom;
        }

        if (location.hash && document.getElementById(location.hash.slice(1))) {
          show(location.hash.slice(1));
        }
      })();
    </script>
  </body>
</html>
