---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

const lastUpdate = '21 mai 2026';

const cookies = [
  {
    cat: 'Essentiels',
    items: [
      { name: 'cookie_consent', purpose: 'Mémorise vos choix de cookies pour éviter de réafficher le bandeau à chaque visite.', duration: '6 mois', type: '1st-party' },
      { name: 'cc_consent (LocalStorage)', purpose: 'Stockage navigateur de la version et des préférences détaillées par catégorie.', duration: '6 mois', type: '1st-party' },
    ],
  },
  {
    cat: 'Mesure d\'audience',
    items: [
      { name: '(aucun pour le moment)', purpose: 'Aucun outil de mesure d\'audience n\'est actuellement déposé.', duration: '·', type: '·' },
    ],
  },
  {
    cat: 'Marketing',
    items: [
      { name: '(aucun pour le moment)', purpose: 'Aucun outil marketing tiers n\'est actuellement déposé.', duration: '·', type: '·' },
    ],
  },
];
---

<BaseLayout
  title="Politique de cookies | CapWeb"
  description="Politique de cookies de CapWeb · catégories, finalités, durées et comment modifier vos choix."
  noindex={true}
>
  <NavBar />
  <main>

    <section class="page-hero section-dark">
      <div class="container page-hero__inner">
        <p class="section-label">Vie privée</p>
        <div class="divider"></div>
        <h1>Politique<br /><em class="text-accent">de cookies</em></h1>
        <p class="page-hero__sub">
          Nous croyons à la transparence. Cette page liste précisément les cookies utilisés sur capweb.pro,
          leur finalité et leur durée. Vous gardez le contrôle à tout moment.
        </p>
        <p class="page-hero__meta">Dernière mise à jour : {lastUpdate}</p>
      </div>
    </section>

    <section class="section">
      <div class="container cookies-layout">

        <article class="cookies-body">

          <section class="cookies-section">
            <h2>Qu'est-ce qu'un cookie ?</h2>
            <p>
              Un cookie est un petit fichier déposé sur votre appareil par un site web. Il peut servir à
              mémoriser vos préférences, à sécuriser une connexion ou à mesurer l'audience. Tous les cookies
              ne se valent pas : certains sont indispensables, d'autres optionnels.
            </p>
          </section>

          <section class="cookies-section">
            <h2>Vos choix</h2>
            <p>
              À votre première visite, un bandeau vous propose trois options strictement équivalentes :
              <strong>Tout refuser</strong>, <strong>Personnaliser</strong> et <strong>Tout accepter</strong>.
              Votre choix est conservé 6 mois.
            </p>
            <p>
              Vous pouvez modifier vos préférences à tout moment via le lien
              <button type="button" class="cookies-link-btn" onclick="window.cookieConsent?.open()">« Gérer mes cookies »</button>
              en bas de chaque page.
            </p>
          </section>

          <section class="cookies-section">
            <h2>Catégories de cookies utilisés</h2>

            {cookies.map(group => (
              <div class="cookies-group">
                <h3>{group.cat}</h3>
                <div class="cookies-table-wrap">
                  <table class="cookies-table">
                    <thead>
                      <tr>
                        <th>Nom</th>
                        <th>Finalité</th>
                        <th>Durée</th>
                        <th>Origine</th>
                      </tr>
                    </thead>
                    <tbody>
                      {group.items.map(c => (
                        <tr>
                          <td><code>{c.name}</code></td>
                          <td>{c.purpose}</td>
                          <td>{c.duration}</td>
                          <td>{c.type}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </section>

          <section class="cookies-section">
            <h2>Désactiver les cookies dans votre navigateur</h2>
            <p>
              En complément de notre bandeau, vous pouvez configurer votre navigateur pour bloquer ou supprimer
              les cookies :
            </p>
            <ul class="cookies-list">
              <li><a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener noreferrer">Google Chrome</a></li>
              <li><a href="https://support.mozilla.org/fr/kb/proteger-vie-privee-bloquer-cookies" target="_blank" rel="noopener noreferrer">Mozilla Firefox</a></li>
              <li><a href="https://support.apple.com/fr-fr/guide/safari/sfri11471/mac" target="_blank" rel="noopener noreferrer">Apple Safari</a></li>
              <li><a href="https://support.microsoft.com/fr-fr/microsoft-edge" target="_blank" rel="noopener noreferrer">Microsoft Edge</a></li>
            </ul>
          </section>

          <section class="cookies-section">
            <h2>Contact</h2>
            <p>
              Pour toute question relative à cette politique :
              <a href="mailto:contact@capweb.pro">contact@capweb.pro</a>.
            </p>
          </section>

        </article>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero { padding: 9rem 0 var(--spacing-xl); }
  .page-hero__inner h1 { margin: var(--spacing-sm) 0; }
  .page-hero__sub {
    max-width: 600px;
    color: rgba(247, 244, 238, 0.6);
    margin-top: var(--spacing-sm);
    font-size: 1rem;
    line-height: 1.8;
  }
  .page-hero__meta {
    margin-top: var(--spacing-sm);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.35);
  }

  .cookies-layout { max-width: 820px; margin-inline: auto; }

  .cookies-section { margin-bottom: var(--spacing-xl); scroll-margin-top: 6rem; }
  .cookies-section:last-child { margin-bottom: 0; }

  .cookies-section h2 {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-text);
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .cookies-section h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-primary);
    margin: var(--spacing-md) 0 0.6rem;
  }

  .cookies-section p,
  .cookies-section li {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .cookies-section p { margin-bottom: var(--spacing-sm); }

  .cookies-section a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(255, 107, 44, 0.3);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition);
  }

  .cookies-section a:hover { text-decoration-color: var(--color-accent); }

  .cookies-link-btn {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(255, 107, 44, 0.3);
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .cookies-link-btn:hover { text-decoration-color: var(--color-accent); }

  .cookies-group { margin-bottom: var(--spacing-md); }

  .cookies-table-wrap { overflow-x: auto; }

  .cookies-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    margin-top: 0.5rem;
  }

  .cookies-table th,
  .cookies-table td {
    text-align: left;
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    vertical-align: top;
  }

  .cookies-table th {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-text);
    text-transform: uppercase;
    background: var(--color-bg-alt);
    border-bottom-color: rgba(255, 107, 44, 0.3);
  }

  .cookies-table code {
    font-family: 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
    font-size: 0.82rem;
    color: var(--color-text);
    background: rgba(255, 107, 44, 0.08);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .cookies-list {
    list-style: none;
    padding: 0;
    margin: var(--spacing-sm) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cookies-list li {
    padding: 0.35rem 0.85rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .cookies-section h2 { font-size: 1.35rem; }
  }
</style>
