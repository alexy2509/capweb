---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    title: 'Cabinet Dubois & Associés',
    category: 'Site vitrine',
    tech: ['Astro', 'CSS'],
    gradient: 'linear-gradient(135deg, #1B3A2F 0%, #2A5242 50%, #1a3028 100%)',
    year: '2024',
    href: '#',
  },
  {
    title: 'Maison Créole',
    category: 'E-commerce',
    tech: ['Shopify', 'JavaScript'],
    gradient: 'linear-gradient(135deg, #3D2009 0%, #7A4520 50%, #C8703A 100%)',
    year: '2024',
    href: '#',
  },
  {
    title: 'Studio Lumière',
    category: 'Portfolio',
    tech: ['Next.js', 'Sanity'],
    gradient: 'linear-gradient(135deg, #0F0F14 0%, #1e1e2e 50%, #2d2b47 100%)',
    year: '2023',
    href: '#',
  },
  {
    title: 'Beaumont Immobilier',
    category: 'Site vitrine',
    tech: ['Astro', 'TypeScript'],
    gradient: 'linear-gradient(135deg, #1a2e20 0%, #7A9E8A 100%)',
    year: '2024',
    href: '#',
  },
  {
    title: 'Atelier Savoyard',
    category: 'E-commerce',
    tech: ['WooCommerce', 'PHP'],
    gradient: 'linear-gradient(135deg, #2a1505 0%, #8B4513 50%, #D2691E 100%)',
    year: '2023',
    href: '#',
  },
  {
    title: 'Dr. Moreau — Médecin',
    category: 'Site vitrine',
    tech: ['WordPress', 'CSS'],
    gradient: 'linear-gradient(135deg, #0a1628 0%, #1e3a5f 50%, #2563EB 100%)',
    year: '2023',
    href: '#',
  },
  {
    title: 'Les Jardins du Château',
    category: 'Site vitrine',
    tech: ['Astro', 'CSS'],
    gradient: 'linear-gradient(135deg, #1a0f00 0%, #4a3000 50%, #C8A96E 100%)',
    year: '2024',
    href: '#',
  },
  {
    title: 'Photographe Claire B.',
    category: 'Portfolio',
    tech: ['Gatsby', 'GraphQL'],
    gradient: 'linear-gradient(135deg, #1a1a1a 0%, #383838 50%, #555 100%)',
    year: '2022',
    href: '#',
  },
  {
    title: 'Café des Arts',
    category: 'Site vitrine',
    tech: ['Astro', 'CSS'],
    gradient: 'linear-gradient(135deg, #1a0808 0%, #6B2121 50%, #C04040 100%)',
    year: '2024',
    href: '#',
  },
];
---

<BaseLayout
  title="Portfolio"
  description="Découvrez nos réalisations web : sites vitrine, boutiques e-commerce, portfolios et applications sur-mesure créés pour nos clients."
>
  <NavBar />
  <main>

    <!-- ========== PAGE HERO ========== -->
    <section class="page-hero section-dark">
      <div class="container page-hero__inner">
        <p class="section-label">Nos réalisations</p>
        <div class="divider"></div>
        <h1>Des projets qui<br /><em class="text-accent">parlent d'eux-mêmes</em></h1>
        <p class="page-hero__sub">
          Chaque projet est une collaboration unique. Voici une sélection de sites
          que nous avons créés pour des clients aussi différents que passionnants.
        </p>
      </div>
    </section>

    <!-- ========== PROJETS ========== -->
    <section class="section" aria-label="Grille de projets">
      <div class="container">
        <div class="portfolio-grid">
          {projects.map(p => <PortfolioCard {...p} />)}
        </div>
      </div>
    </section>

    <!-- ========== CTA ========== -->
    <section class="section section-alt cta-band">
      <div class="container cta-band__inner">
        <div>
          <p class="section-label">Votre projet</p>
          <div class="divider"></div>
          <h2>Votre site pourrait<br /><em class="text-accent">être le prochain.</em></h2>
        </div>
        <div class="cta-band__actions">
          <a href="/contact" class="btn btn-primary">Démarrer mon projet</a>
          <a href="/services" class="btn btn-outline">Voir nos offres</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: 9rem 0 var(--spacing-xl);
  }

  .page-hero__inner h1 { margin: var(--spacing-sm) 0; }

  .page-hero__sub {
    max-width: 560px;
    color: rgba(247,244,238,0.6);
    margin-top: var(--spacing-sm);
    font-size: 1rem;
    line-height: 1.8;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
  }

  .cta-band {
    border-top: 1px solid var(--color-border);
  }

  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .cta-band__actions {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .portfolio-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .portfolio-grid { grid-template-columns: 1fr; }
    .cta-band__inner { flex-direction: column; align-items: flex-start; }
  }
</style>
